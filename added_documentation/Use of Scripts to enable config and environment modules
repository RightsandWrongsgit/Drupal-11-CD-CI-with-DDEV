#!/bin/bash

# List of Drupal modules to enable
MODULES=(
  admin_toolbar
  pathauto
  # Add more modules here, one per line
  # Example: ctools
  # Example: token
)

# Check if Drush is available
if ! command -v vendor/bin/drush &> /dev/null; then
  echo "Error: Drush not found. Please ensure Drush is installed via Composer."
  exit 1
fi

# Enable each module using Drush
for MODULE in "${MODULES[@]}"; do
  echo "Enabling module: $MODULE"
  vendor/bin/drush en "$MODULE" -y
  if [ $? -ne 0 ]; then
    echo "Error: Failed to enable $MODULE"
    exit 1
  fi
done

# Rebuild cache to ensure modules are active
echo "Rebuilding cache..."
vendor/bin/drush cache:rebuild
if [ $? -ne 0 ]; then
  echo "Error: Failed to rebuild cache"
  exit 1
else
  echo "Modules enabled and cache rebuilt successfully."
fi
```

