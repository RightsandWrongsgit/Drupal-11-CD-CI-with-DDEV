ddev drush config-set config_split.config_split.develop_split modules "[environment_indicator,structure_sync]" -y

ddev drush config-set config_split.config_split.staged_split folder ../config/staged -y
ddev drush config-set config_split.config_split.staged_split modules "[environment_indicator,structure_sync]" -y

ddev drush config-set config_split.config_split.main_split folder ../config/main -y
ddev drush config-set config_split.config_split.main_split modules "[]" -y

# Rebuild cache
ddev drush cache:rebuild
echo "Config Split module configured successfully."
