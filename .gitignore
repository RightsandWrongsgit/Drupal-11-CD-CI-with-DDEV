# This gitignore file was customized from the one that the standard Lando template from Platformsh provided

# Ignore directories generated by Composer
/drush/contrib/
/vendor/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/
/web/libraries/
console/

# Ignore sensitive information & exposing file to host, we are doing a my-example.settings.local.php you need to look at
/web/sites/*/settings.local.php

# Ignore Drupal's file directory
/web/sites/*/files/

# Ignore SimpleTest multi-site environment.
/web/sites/simpletest

# Ignore IDE files
/.idea/
/.vscode/
*.code_workspace
*.iml

# Ignore node modules
node_modules

# Ignore some CSS related stuff
*.css.map
*.css.map.map

# Ignore all log files
*.log

# Ignore .env files as they are personal
/.env

# Ignore ddev global config that has a token for Platform.sh connection
/.ddev/global_config.yaml

# Ignore mounts
web/sites/default/files
tmp

# private
.drush
drush-backups
.console
.ssh/
known_hosts

# Ignore default text files
/CHANGELOG.txt
/COPYRIGHT.txt
/INSTALL.txt
/LICENSE.txt
/MAINTAINERS.txt
/UPGRADE.txt
/README.txt
sites/README.txt
sites/all/modules/README.txt
sites/all/themes/README.txt

# Ignore paths that contain user-generated content
sites/*/files
sites/*/private

# Ignore directories created by Platform.sh
.subversion

# The following is set up to work with the split environments recipe
# in the recipes/split_environments/split_environments.recipe.yml file
# Ignore configuration directories except for specific files we want to keep
# The ! negation operator is used to exclude specific files from being ignored
# A minimal baseline configuration for the config sync directory is kept
# to ensure Drupal can bootstrap properly. Additional configuration files
# are managed through the split environments recipe and should be imported
# as needed for each environment.
# See https://www.drupal.org/docs/develop/configuration-management/configuration-split for
/.ddev/.db-dumps/
# Do NOT ignore config/sync at all — we want the full directory in Git and on Platform.sh
!/config/sync/
!/config/develop/*
!/config/staged/*
!/config/main/*
!/config/local/*


# Ignore files generated by your OS that are internal to your setup
*.DS_Store